{
	"name": "wok-client",
	"productName": "WOK Client",
	"version": "1.1.0-rc.1",
	"private": true,
	"description": "Hardware-adaptive, performance-focused Krunker desktop client based on Crankshaft",
	"main": "./bundle/main.mjs",
	"type": "module",
	"scripts": {
		"postinstall": "node scripts/install-electron.mjs",
		"start": "node scripts/bundle.mjs && electron-forge start -- --ozone-platform=x11",
		"make": "node scripts/bundle.mjs && node scripts/verify-bundle.mjs && electron-forge make",
		"bundle": "node scripts/bundle.mjs",
		"bundle:verify": "node scripts/bundle.mjs && node scripts/verify-bundle.mjs",
		"lab:build": "node lab/offline-runtime/scripts/build.mjs",
		"lab:noise-floor": "node lab/offline-runtime/scripts/noise-floor.mjs",
		"lab:serve": "node lab/offline-runtime/scripts/serve.mjs",
		"lab:run": "node lab/offline-runtime/scripts/run.mjs",
		"lab:test": "node --test lab/offline-runtime/tests/*.test.ts",
		"lab:tournament": "node lab/offline-runtime/scripts/tournament.mjs",
		"lab:tournament:dry-run": "node lab/offline-runtime/scripts/tournament-dry-run.mjs",
		"lint": "biome lint .",
		"test": "node --test tests/*.test.ts lab/offline-runtime/tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"validate": "pnpm run lint && pnpm run typecheck && pnpm test"
	},
	"author": "WOK contributors",
	"contributors": [
		"Crankshaft contributors (https://github.com/KraXen72/crankshaft/graphs/contributors)"
	],
	"license": "GPL-3.0-only",
	"homepage": "https://client.wok.social",
	"repository": {
		"type": "git",
		"url": "https://github.com/nzalexgarciagil-ctrl/wok-client.git"
	},
	"bugs": {
		"url": "https://github.com/nzalexgarciagil-ctrl/wok-client/issues"
	},
	"keywords": [
		"krunker",
		"performance",
		"wok"
	],
	"engines": {
		"node": ">=24.13.0",
		"pnpm": ">=11.15.1"
	},
	"wokClient": {
		"basedOn": {
			"name": "crankshaft",
			"version": "2.0.1",
			"commit": "c1f1ce39e49296735ac73737b1cb6f2b5e5482b2",
			"repository": "https://github.com/KraXen72/crankshaft"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@electron-forge/cli": "8.0.0-alpha.10",
		"@electron-forge/maker-base": "8.0.0-alpha.10",
		"@electron-forge/maker-dmg": "8.0.0-alpha.10",
		"@electron-forge/shared-types": "8.0.0-alpha.10",
		"@electron/asar": "4.2.0",
		"@reforged/maker-appimage": "^5.2.0",
		"@types/node": "24.13.3",
		"electron": "npm:electron-nightly@44.0.0-nightly.20260522",
		"esbuild": "^0.28.1",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.15.1"
}
